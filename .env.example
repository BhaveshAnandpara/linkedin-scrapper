LI_AT_COOKIE=
LI_JSESSIONID=

# Upstash Redis (REST API) — used for per-IP rate limiting. Get these from
# an Upstash Redis database (console.upstash.com) or the Vercel Marketplace
# Upstash integration. If left unset, rate limiting fails open (disabled)
# rather than blocking the API — see src/rateLimit/rateLimiter.ts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Requests allowed per client IP per window. Defaults to 10 per 60s if unset.
RATE_LIMIT_MAX_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Separate, stricter limit for POST /api/sessions and POST /api/sessions/default
# — legitimate callers hit these rarely, so the default is much lower than
# the profile endpoint's. Defaults to 5 per 60s if unset.
SESSION_RATE_LIMIT_MAX_REQUESTS=5
SESSION_RATE_LIMIT_WINDOW_SECONDS=60

# How long a fetched profile is cached (by publicIdentifier) before a repeat
# request re-fetches from LinkedIn. Defaults to 600s (10 min) if unset. Uses
# the same Upstash Redis instance above; caching is skipped if unconfigured.
PROFILE_CACHE_TTL_SECONDS=600

# Guardrails on outbound LinkedIn calls (src/linkedin/callConcurrency.ts):
# how many may be in flight at once under the shared session, and how long a
# request that lost the per-identifier fetch race waits for the winner's
# result before giving up with a LINKEDIN_AT_CAPACITY error. Defaults to 5
# concurrent calls / 8000ms if unset.
LINKEDIN_MAX_CONCURRENT_CALLS=5
LINKEDIN_FOLLOWER_WAIT_MS=8000

# Guards POST /api/sessions/default (refreshes the shared LinkedIn session
# without a redeploy). Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Send it as the X-Admin-Secret header on that request. Never share it.
ADMIN_SECRET=
